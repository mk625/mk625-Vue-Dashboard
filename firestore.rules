rules_version = '2';

// ===============================================================
// Assumed Data Model (prototype / unauthenticated access)
// ===============================================================
//
// Collection: users-list
// Fields:
//   - id: number (required)
//   - name: string (required)
//   - email: string (required)
//   - phone: string (required)
//   - location: string (required)
//
// Collection: dashboard-items
// Fields:
//   - title: string
//   - count: number | string
//   - description: string
//
// WARNING: These rules allow public read/write for development only.
// Do not use this configuration for a production app.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidUser() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'name', 'email', 'phone', 'location'])
        && data.id is int
        && data.name is string
        && data.name.size() > 0
        && data.email is string
        && data.email.size() > 0
        && data.phone is string
        && data.phone.size() > 0
        && data.location is string
        && data.location.size() > 0;
    }

    match /users-list/{userId} {
      allow read: if true;
      allow create, update: if isValidUser();
      allow delete: if true;
    }

    match /dashboard-items/{itemId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
